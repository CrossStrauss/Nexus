<div class="fixed top-8 right-10 animate-move-alert bg-primary-custom">
    <% if notice.present? %>
        <p class="notice w-[auto] py-4 px-6 nowrap text-white" data-controller="alert"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
        <p class="alert w-[auto] py-4 px-6 nowrap text-white"><%= alert %></p>
    <% end %>
</div>